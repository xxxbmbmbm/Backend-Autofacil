# Copiar como .env y completar TODAS las variables. El archivo .env NO se sube a GitHub.
# docker compose se detiene con un aviso si falta alguna.

# MySQL (generar con: openssl rand -hex 16)
MYSQL_ROOT_CLAVE=CambiaEstaClaveRoot
DB_USUARIO=autofacil
DB_CLAVE=CambiaEstaClaveDB

# Secreto JWT compartido por los 4 microservicios (Base64, mínimo 32 bytes).
# Generar con: openssl rand -base64 48
JWT_SECRETO=

# Cuentas que se crean al iniciar ms-usuarios por primera vez
ADMIN_CORREO=admin@autofacil.cl
ADMIN_CLAVE=CambiaEstaClaveAdmin
VENDEDOR_CORREO=vendedor@autofacil.cl
VENDEDOR_CLAVE=CambiaEstaClaveVendedor
